  "decisions": [
    {
      "evidence_ids": [],
      "id": "DEC-SOURCE-COUNT",
      "owner": null,
      "rationale": "Interview said '8 documents' but its own next answer described the set as covering legal texts, guidance, internal policy, system inventories, evidence records, and action calendars -- which only totals 10 if SYSTEMS/EVIDENCE/CALENDAR are included. Confirmed with the stakeholder.",
      "summary": "Treated all 10 named items as the source set, not literally '8'",
      "tradeoffs": [
        "If a genuine unnamed 8th legal/guidance document exists, this run misses it silently; none surfaced in any fetched content."
      ]
    },
    {
      "evidence_ids": [
        "SRC-POLICY"
      ],
      "id": "DEC-POLICY-MANUAL-EXPORT",
      "owner": null,
      "rationale": "Direct curl of the Notion URL returns a client-rendered shell with no page body; a stdlib-only script cannot execute the JS that renders real content, so a 'live fetch' would return the same empty result every run. Confirmed with the stakeholder.",
      "summary": "POLICY captured as a manual-export local reference, not a live fetch",
      "tradeoffs": [
        "Cannot detect if the Notion page's content changes between runs the way a live HTML/CSV fetch can; re-export is a manual step tied to the AI-POL-2026-08-15 version string."
      ]
    }
  ],
